# Copy to .env and fill your BotHub key/model.
BOTHUB_API_KEY=
BOTHUB_MODEL=
BOTHUB_BASE_URL=

# Backend/UI
HOST=127.0.0.1
PORT=8017
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Data locations
ARKNIGHTS_GAMEDATA=G:\Programs\GameAgent\ArknightsGamedata
ARKNIGHTS_GAMEDATA_ZH=G:\Programs\GameAgent\ArknightsGameData_Zh_CN
ARKNIGHTS_STORY_JSON=G:\Programs\GameAgent\ArknightsStoryJson
ARKNIGHTS_IMAGES=G:\Programs\GameAgent\Arknight-Images
DATABASE_PATH=G:\Programs\GameAgent\data\arknights_agent.sqlite

# Token economy
MAX_CONTEXT_RESULTS=8
MAX_CONTEXT_CHARS=9000
MAX_HISTORY_MESSAGES=8

# Model tool calls are supported but can be disabled if the selected BotHub model rejects tools.
ENABLE_MODEL_TOOLS=true
