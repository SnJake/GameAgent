# Copy to .env and fill your BotHub key/model.
BOTHUB_API_KEY=
BOTHUB_MODEL=
BOTHUB_BASE_URL=https://bothub.chat/api/v2/openai/v1

# LLM provider selection: bothub, openrouter, xai, openai, gemini.
LLM_PROVIDER=bothub
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://127.0.0.1:5173
OPENROUTER_X_TITLE=GameAgent

XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=

# Backend/UI
HOST=127.0.0.1
PORT=8017
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Data locations
ARKNIGHTS_GAMEDATA=G:\Programs\GameAgent\ArknightsGamedata
ARKNIGHTS_GAMEDATA_ZH=G:\Programs\GameAgent\ArknightsGameData_Zh_CN
ARKNIGHTS_STORY_JSON=G:\Programs\GameAgent\ArknightsStoryJson
ARKNIGHTS_IMAGES=G:\Programs\GameAgent\Arknight-Images
DATABASE_PATH=G:\Programs\GameAgent\data\arknights_agent.sqlite

# Token economy
MAX_CONTEXT_RESULTS=8
MAX_CONTEXT_CHARS=9000
MAX_HISTORY_MESSAGES=8

# Model tool calls are supported but can be disabled if the selected BotHub model rejects tools.
ENABLE_MODEL_TOOLS=true

# External search
WIKI_SEARCH_ENABLED=true
WIKI_SEARCH_MAX_RESULTS=4
ENDFIELD_WIKI_SEARCH_ENABLED=false
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
